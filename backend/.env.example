# ==============================================================================
# BROTAR BOLIVIA - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de Datos PostgreSQL (Prisma ORM) ---
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/brotar_db?schema=public"

# --- Autenticación & Seguridad JWT ---
JWT_SECRET=tu_clave_secreta_jwt_muy_segura
JWT_EXPIRATION=7d

# --- URL del Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Configuración SMTP de Correo (Gmail / Workspace) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_de_16_caracteres
SMTP_FROM="Brotar Bolivia <tu_correo@gmail.com>"
